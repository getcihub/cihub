// The Alloy of compose.yaml (profile observability): sends the logs of the
// containers of this compose project to Loki, with the name of the service
// as the label `service`. cihub-server writes JSON lines: a query parses
// them with `| json` (specs/OBSERVABILITY.md).

discovery.docker "compose" {
  host = "unix:///var/run/docker.sock"
  // The default (1 minute) misses the one-shot services, such as cihub-migrate.
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "compose" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "compose" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.compose.targets
  relabel_rules = discovery.relabel.compose.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
