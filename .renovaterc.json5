{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  dependencyDashboardTitle: "Renovate Dashboard",
  // Every update is merged by a person.
  automerge: false,
  // Fresh releases often finish uploading per-platform assets after the tag;
  // locking too early leaves mise.lock with missing platform entries.
  minimumReleaseAge: "3 days",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on the first day of the month"],
  },
  packageRules: [
    {
      description: "GitHub Actions",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      description: "mise tools",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: "TypeScript 7: typescript-eslint does not support it yet",
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      description: "Rust toolchain, apart from the other mise tools",
      matchManagers: ["mise"],
      matchDepNames: ["rust"],
      groupName: "Rust toolchain",
      groupSlug: "rust-toolchain",
    },
  ],
}
