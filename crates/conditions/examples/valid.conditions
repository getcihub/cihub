-draft
-conflict
review-decision = approved
#approved-reviews-by >= 2
#review-threads-unresolved = 0
check-success = lint
-check-failure ~= .
check-pending = e2e
label = ready-to-merge
-label = do-not-merge
label ~= ^area/
author != dependabot[bot]
sender-permission >= write
files *= src/**/*.rs
title ~= ^feat
additions < 500
base = main
queue-position = 0
queue-age < 1h
pr-age > 1d
label = hotfix
check-success = e2e
