# A pipelined queue on `main`: two PRs tested at the same time, one failure
# retried by the failure budget, an urgent PR, and a push from outside.
settings window=2 retries=1

push base-1                # the tick reads the head of `main`

# PR 1 and PR 2 enter the queue; PR 2 is tested on top of PR 1.
submit 1
observe 1                  # mergeable: admitted, then tested
submit 2
observe 2
assemble 1
assemble 2

# PR 2 passes first and waits for PR 1; PR 1 passes, and both merge in order.
pass 2
pass 1
merge

# PR 3 fails once: the failure budget retries it, then it fails again.
submit 3
observe 3
assemble 3
fail 3
assemble 3
fail 3

# PR 4 conflicts with `main`; it enters the queue when it becomes mergeable.
submit 4
observe 4 conflict
observe 4

# An urgent PR goes in front of PR 4, which is tested again behind it.
submit 5 urgent
observe 5

# A push from outside the queue: every group restarts on the new base.
push base-2
show

# PR 5 is merged; PR 4 is cancelled by a push on its head.
assemble 5
pass 5
merge
observe 4 head=head-4b
