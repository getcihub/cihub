# Copy to deploy/compose/.env and fill in. Never commit deploy/compose/.env.
# Use long random values without special characters, for example the output
# of `openssl rand -hex 32`.

# Postgres: the superuser, and the role that CIHub uses.
POSTGRES_PASSWORD=change-me
CIHUB_DB_PASSWORD=change-me

# The GitHub App (specs/GITHUB.md).
CIHUB_GITHUB_APP_ID=123456
CIHUB_GITHUB_WEBHOOK_SECRET=change-me
# The path on this host of the private key of the App (.pem). The user of
# the image (uid 65532) must be able to read it: on Linux,
# `sudo chown 65532 <file> && chmod 0400 <file>`.
CIHUB_GITHUB_PRIVATE_KEY_PATH=./github-app.private-key.pem
# The sign-in to the dashboard: the address of this instance, and the client
# of the App, whose Callback URL is <CIHUB_HTTP_PUBLIC_URL>/auth/github/callback.
# CIHUB_HTTP_PUBLIC_URL=https://ci.example.com
# CIHUB_GITHUB_CLIENT_ID=Iv23li…
# CIHUB_GITHUB_CLIENT_SECRET=change-me
# Only for a GitHub Enterprise Server.
# CIHUB_GITHUB_URL=https://github.example.com

# Optional.
# CIHUB_IMAGE=ghcr.io/getcihub/cihub:latest
# CIHUB_HTTP_PORT=8080
# CIHUB_LOG_FILTER=info
