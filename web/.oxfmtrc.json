{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "dist/",
    "test-results/",
    "playwright-report/",
    "pnpm-lock.yaml",
    "openapi.json",
    "src/client/",
    "src/routeTree.gen.ts"
  ]
}
