  "components": {
    "schemas": {
      "Accepted": {
        "type": "object",
        "description": "A request that the queue does later: a submission reads the PR first.",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "description": "An action of an admin, or a change of a queue.",
        "required": [
          "id",
          "action",
          "target",
          "occurred_at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "object",
              "null"
            ]
          },
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "target": {
            "type": "string"
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "description": "A page of the audit log, newest first.",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
